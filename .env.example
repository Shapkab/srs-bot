# Copy to .env and fill in. .env is gitignored.

# Telegram bot token from @BotFather
BOT_TOKEN=

# SQLite DB path. Relative paths resolve from the project root.
DB_PATH=srs.db

# Your Telegram user ID. Used as a hard allowlist for v1 (single-user).
# Get yours by messaging @userinfobot.
OWNER_TELEGRAM_ID=

# IANA timezone name (e.g. Europe/Sofia). Used for daily reminder scheduling.
TZ=Europe/Sofia

# Daily reminder time, HH:MM in TZ above.
REMINDER_TIME=09:00

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# OpenAI API key — used to generate IPA pronunciation for card fronts
# (gpt-4o-mini). Required: the bot will not start without it.
OPENAI_API_KEY=

# Where card-attached images live (one file per image, named by sha256).
# Relative paths resolve from the project root. In the Fly deployment
# this should be /data/images so it sits on the persistent volume.
IMAGE_DIR=./images
